# Created by: python cloudctl.py init
# Fill these FIVE values. Keep this file private and out of Git.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
TC_DASHSCOPE_KEY=
# Globally unique OSS name, 3-63 lowercase letters/digits/hyphens.
TC_BUCKET=
# Tablestore instance name: 3-16 letters/digits/hyphens, starts with a letter.
TC_OTS_INSTANCE=

# Generated automatically by init; shared by Compose and the cloud API.
TC_PANEL_TOKEN=

# Defaults; Beijing DashScope key and resources must use the same supported region.
TC_REGION=cn-beijing
TC_PREFIX=transcript
# true only when you supply an already-existing bucket in this region.
TC_EXISTING_BUCKET=false
# Optional for temporary credentials. Refresh before they expire.
ALIBABA_CLOUD_SECURITY_TOKEN=

# Written automatically after up/check. Do not copy endpoint URLs manually.
TC_API_URL=
