# PowerShell: set these with $env:NAME = 'value'; uv does not load this file automatically.
TC_API_URL=https://replace-with-fc-http-endpoint
TC_PANEL_TOKEN=replace-with-a-random-token-at-least-24-characters
TC_DASHSCOPE_KEY=replace-with-beijing-dashscope-key
# Local SDK credentials (prefer temporary credentials / a restricted RAM identity).
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
# Only needed for running the backend locally against cloud resources:
TC_REGION=cn-beijing
TC_BUCKET=replace-with-your-bucket
TC_OTS_INSTANCE=replace-with-your-instance
TC_FLOW=transcript-parse
TC_ALLOWED_ORIGIN=http://localhost:8787
TC_MAX_ACTIVE=4
